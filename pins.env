# Pinned artefacts for the Visiblaze secret-scan action.
#
# ── Why this file exists rather than a version string in action.yml ──
#
# The action downloads and EXECUTES a binary on a customer's runner, next to their source and
# whatever credentials that job holds. We are the security vendor in that transaction, so "fetch
# the latest release" is not available to us: it means whatever appears at a URL we do not control
# becomes code we told a customer to run. A pinned version plus a committed digest means a
# re-tagged release, a replaced artefact or a MITM changes the digest and the job stops instead of
# executing.
#
# ── Why this action has fewer pins than the SAST one ──
#
# It has no third-party scanner. The SAST action downloads Opengrep and pins its signing identity.
# Credential detection is regular expressions over text, so it is implemented in our own scanner.
# The one other download is cosign, which verifies that our scanner archive was signed by the
# Visiblaze release workflow - the same check, with the same pinned cosign, the SAST action makes.
#
# The sentinel is `UNSET`. action.yml checks for it and fails closed, so the action cannot run with
# an unverified pin. Any pin reset to UNSET disables the action until it is filled again.

# Where our own scanner release lives. A full base URL rather than a derived one: the action is
# also run from an in-repo path during CI, where github.action_repository is empty — so deriving it
# would work in the published case and silently break the case that proves the published case.
SCANNER_BASE_URL=https://github.com/Visiblaze/visiblaze-sast-scan/releases/download

# The release to fetch. A tag, never a branch and never "latest": the action is consumed at a
# pinned SHA, and a floating version behind a pinned action would make the thing a customer pinned
# not actually determine what runs.
#
# Both binaries ship from the same release under the same version, because they post to the same
# ingest and two version numbers would leave a customer unable to say which produced a finding.
SCANNER_VERSION=v1.34.0

# Digests of the secret-scanner archives, committed here rather than read from the release.
#
# The release's own checksums.txt defends against a corrupted download and not against a
# compromised release — whoever can replace the archive can replace the file that vouches for it.
# With these here, the action SHA a customer pins determines the bytes that execute.
#
# Both MUST be updated whenever SCANNER_VERSION moves. The release workflow prints them, and the
# action refuses to run rather than falling back if the pin for its architecture is missing.
SCANNER_SHA256_LINUX_AMD64=81f5982c12adfd66f13eca8942fbf6009eb77dd8324d82415f0e1dda7f4e987c
SCANNER_SHA256_LINUX_ARM64=4fad9f39cc6dcf7fc75e429d5635ee7da728dba248863420d632128fd6761d2c

# ── Scanner release signing ──
#
# Every archive in a signed release carries a Sigstore bundle (<archive>.sigstore.json) signed by
# our release workflow. With SCANNER_SIGNED=true the action REQUIRES the bundle and verifies it
# against the identity below before it runs anything: the digest says these are the bytes this
# action commit names, the signature says our release pipeline built them. Must equal the SAST
# action's values (pins_test.go in the backend checks it).
SCANNER_SIGNED=true
SCANNER_CERT_IDENTITY_REGEXP='^https://github[.]com/Visiblaze/visiblaze-IQ-Backend/[.]github/workflows/release-scanner[.]yml@refs/heads/(main|dev)$'
SCANNER_CERT_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Cosign, pinned the way the SAST action pins it: these digests are the ones sigstore publishes in
# cosign_checksums.txt, not ones computed from the same download.
COSIGN_VERSION=v3.1.3
COSIGN_URL_LINUX_AMD64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64
COSIGN_SHA256_LINUX_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
COSIGN_URL_LINUX_ARM64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-arm64
COSIGN_SHA256_LINUX_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a

# Origins this action may send findings to. Space separated, scheme and host only.
#
# Checked by the wrapper rather than by the scanner, so the guarantee — findings can only reach a
# Visiblaze endpoint — is one a reviewer can verify by reading this repository instead of trusting
# a compiled binary. Adding an origin is a visible diff in the commit a customer pins.
#
# An empty value is REFUSED at runtime, not treated as unrestricted: a truncated pins.env must not
# read as permission.
#
# ── CURRENTLY DEV ONLY, AND THAT IS A LIMIT, NOT A DEFAULT ──
#
# The single origin below is the Visiblaze DEV ingest gateway. Until a production origin is added
# here, a customer pointed at a production endpoint gets a refused step — which is the correct
# failure (findings never reach an origin this file does not name) but it means this action is not
# yet usable outside dev.
#
# Adding the production origin is the change that makes it so, and it belongs in a commit of its
# own: a customer pins this repository by SHA, so the set of places their credentials may be sent
# is fixed at the SHA they pinned, and widening it should be a diff someone reviewed.
# MUST BE QUOTED once this holds more than one origin. pins.env is `source`d with `set -a`, so
# an unquoted `KEY=a b` parses as "run command `b` with KEY=a in its environment" — the shell
# variable is then never set, the allowlist reads EMPTY, and every origin is refused with a message
# blaming the caller's api-url. Verified 2026-09-08. The quotes are harmless with one value, so
# they are here now rather than added by whoever adds the second.
ALLOWED_API_ORIGINS="https://qwc3m6imgj.execute-api.ap-south-1.amazonaws.com"
