# Pinned artefacts for the Visiblaze secret-scan action.
#
# ── Why this file exists rather than a version string in action.yml ──
#
# The action downloads and EXECUTES a binary on a customer's runner, next to their source and
# whatever credentials that job holds. We are the security vendor in that transaction, so "fetch
# the latest release" is not available to us: it means whatever appears at a URL we do not control
# becomes code we told a customer to run. A pinned version plus a committed digest means a
# re-tagged release, a replaced artefact or a MITM changes the digest and the job stops instead of
# executing.
#
# ── Why this action has so many fewer pins than the SAST one ──
#
# It has no third-party dependency. The SAST action downloads Opengrep, so it must also download
# cosign to verify Opengrep's signature, and pin the signing identity. Credential detection is
# regular expressions over text, so it is implemented in our own scanner and there is exactly one
# artefact to trust — ours. Fewer moving parts is a security property, not a convenience.
#
# The sentinel is `UNSET`. action.yml checks for it and fails closed, so the action cannot run with
# an unverified pin. Any pin reset to UNSET disables the action until it is filled again.

# Where our own scanner release lives. A full base URL rather than a derived one: the action is
# also run from an in-repo path during CI, where github.action_repository is empty — so deriving it
# would work in the published case and silently break the case that proves the published case.
SCANNER_BASE_URL=https://github.com/Visiblaze/visiblaze-sast-scan/releases/download

# The release to fetch. A tag, never a branch and never "latest": the action is consumed at a
# pinned SHA, and a floating version behind a pinned action would make the thing a customer pinned
# not actually determine what runs.
#
# Both binaries ship from the same release under the same version, because they post to the same
# ingest and two version numbers would leave a customer unable to say which produced a finding.
SCANNER_VERSION=v1.5.1

# Digests of the secret-scanner archives, committed here rather than read from the release.
#
# The release's own checksums.txt defends against a corrupted download and not against a
# compromised release — whoever can replace the archive can replace the file that vouches for it.
# With these here, the action SHA a customer pins determines the bytes that execute.
#
# Both MUST be updated whenever SCANNER_VERSION moves. The release workflow prints them, and the
# action refuses to run rather than falling back if the pin for its architecture is missing.
SCANNER_SHA256_LINUX_AMD64=1db0cbddd1b66a9a5af89b847c4a5f5b54c2164fd94cba842fd30614cc566fdb
SCANNER_SHA256_LINUX_ARM64=7d7b69b6c921aa4e5f12eb5ee018f5a08f48ab4a0102f27e4489d82cf11ec607

# Origins this action may send findings to. Space separated, scheme and host only.
#
# Checked by the wrapper rather than by the scanner, so the guarantee — findings can only reach a
# Visiblaze endpoint — is one a reviewer can verify by reading this repository instead of trusting
# a compiled binary. Adding an origin is a visible diff in the commit a customer pins.
#
# An empty value is REFUSED at runtime, not treated as unrestricted: a truncated pins.env must not
# read as permission.
ALLOWED_API_ORIGINS=https://qwc3m6imgj.execute-api.ap-south-1.amazonaws.com
